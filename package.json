{
  "name": "neurix-desktop",
  "version": "0.1.0",
  "description": "NEURIX - asistente de escritorio por voz",
  "author": "NEURIX",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg --x64",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "26.6.10",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.neurix.assistant",
    "productName": "NEURIX",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "index.html", "styles.css", "renderer.js", "package.json"],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "10.13.0",
      "extendInfo": { "NSMicrophoneUsageDescription": "NEURIX necesita el micrófono para escuchar tus comandos de voz." }
    },
    "dmg": {
      "title": "Instalar NEURIX",
      "contents": [
        { "x": 130, "y": 190 },
        { "x": 410, "y": 190, "type": "link", "path": "/Applications" }
      ]
    },
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}